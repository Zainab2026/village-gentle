# API Keys - Copy this file to .env and add your actual keys
# =====================================================

# AI APIs
GROQ_API_KEY=your_groq_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Google APIs
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CSE_ID=your_google_cse_id_here
YOUTUBE_API_KEY=your_youtube_api_key_here

# Search APIs
SERPAPI_KEY=your_serpapi_key_here

# Location APIs
ORS_API_KEY=your_ors_api_key_here
WINDY_API_KEY=your_windy_api_key_here

# Plant/Pest Detection
KINDWISE_API_KEY=your_kindwise_api_key_here

# Nutrition API
NUTRITIONIX_APP_ID=your_nutritionix_app_id_here
NUTRITIONIX_APP_KEY=your_nutritionix_app_key_here

# Hugging Face
HF_TOKEN=your_huggingface_token_here

# Database
MONGODB_URI=your_mongodb_connection_string_here

# Blockchain (Optional)
WEB3_PROVIDER_URL=your_web3_provider_url_here
BLOCKCHAIN_PRIVATE_KEY=your_blockchain_private_key_here
BLOCKCHAIN_WALLET_ADDRESS=your_blockchain_wallet_address_here
BLOCKCHAIN_ENABLED=false